source "https://rubygems.org"

# The same Jekyll + plugin versions GitHub Pages uses, so a local build matches the live one.
gem "github-pages", group: :jekyll_plugins

# `jekyll serve` needs this on Ruby 3.
gem "webrick"

# Standard-library gems that recent Ruby versions no longer bundle (harmless on older Rubies).
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
